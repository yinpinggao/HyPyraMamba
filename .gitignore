# 忽略 Python 编译缓存
__pycache__/
*.pyc

# 忽略训练日志
*.log

# 忽略模型权重文件
*.pth
*.pt

# 忽略可视化结果
*.png

# 忽略评估结果文本
result_*.txt
*.wmf
*.tex
*.npy
*.npz

# 忽略数据集目录
data/
datasets/

# 忽略本地导出的 split/data 缓存
HypraMamba/splits/

# 忽略本地训练输出
HypraMamba/RUNS*/

# 忽略第三方参考仓库（保留 SOURCES.md 记录来源）
tree-hsi-2026/third_party/*
!tree-hsi-2026/third_party/SOURCES.md

# 忽略中止/失败的训练输出
tree-hsi-2026/outputs/*_aborted*/

# 忽略竞赛提交 CSV（单文件数百 MB，不入库）
tree-hsi-2026/submissions/*.csv

# 忽略根目录打包产物（代码评审包、提交压缩包）
/*.zip
HypraMamba_model_code_review_20260818/

# 忽略 TensorBoard 事件文件（体积大，非 champion 血统产物）
tree-hsi-2026/outputs/**/tensorboard/
